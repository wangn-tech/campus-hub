app:
  name: campushub
  env: prod
  timezone: Asia/Shanghai
  instance_id: replace-me
http:
  host: 0.0.0.0
  port: 8080
  allowed_origins: []
mysql:
  host: mysql
  port: 3306
  username: campushub
  password: ""
  database: campushub
  charset: utf8mb4
  max_open_conns: 50
  max_idle_conns: 10
  conn_max_lifetime: 30m
  log_level: warn
redis:
  host: redis
  port: 6379
  database: 0
  pool_size: 50
  min_idle_conns: 5
  dial_timeout: 5s
  read_timeout: 3s
  write_timeout: 3s
kafka:
  brokers:
    - kafka:9092
  client_id: campushub-backend
  producer_acks: all
  producer_batch_size: 100
  consumer_group: campushub-backend
  chat_delivery_group_prefix: campushub.chat-delivery
  enable_consumers: true
  sasl_enabled: false
elasticsearch:
  addresses:
    - http://elasticsearch:9200
  alias: activities
  index_prefix: campushub
  enable_search: true
  request_timeout: 10s
storage:
  driver: rustfs
  endpoint: rustfs:9000
  access_key: ""
  secret_key: ""
  bucket: campushub
  use_path_style: true
  use_ssl: true
  presign_ttl: 15m
  max_image_size: 5242880
mail:
  host: ""
  port: 587
  username: ""
  password: ""
  from: ""
  tls_mode: starttls
security:
  pii_encryption_key: ""
  pii_hash_key: ""
jwt:
  issuer: campushub
  access_secret: ""
  refresh_secret: ""
log:
  level: info
  encoding: json
  output: stdout
observability:
  readiness_timeout: 3s
